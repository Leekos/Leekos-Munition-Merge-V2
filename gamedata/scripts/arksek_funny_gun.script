if not cxv_artigrok_bo and grok_bo then

	original_grok_bo_npc = grok_bo.npc_on_before_hit
	
	-- borrowed from grok_bo for detection of npc death because it handles everything
	
	grok_bo.npc_on_before_hit = function(npc, shit, bone_id)
		original_grok_bo_npc(npc, shit, bone_id)
		-- if the shot is not by actor...
		if shit.draftsman:id() ~= db.actor:id() then
			return
		end
		-- if the shot is not a headshot...
		if not (tonumber(bone_id) >= 14 and tonumber(bone_id) <= 19) then
			return
		end
		-- if the shot isnt from the energy gun
		-- if the npc is dead...
		if npc.health <= 0 then
			local wpn = db.actor:active_item()
			if not wpn then return end
			local parent_section = ini_sys:r_string_ex(wpn:section(), "parent_section") or wpn:section()
			if parent_section ~= weapon_section then return end
			local id = wpn:id()
			repeat_delays_table["repeat_delay"..id] = fast_repeat_timing
			--repeat_delay = fast_repeat_timing
			ResetTimeEvent("arksek_funny_gun", "repeat_loop_for_"..id, repeat_delays_table["repeat_delay"..id])
			RemoveTimeEvent("arksek_funny_gun", "reset_to_lower_repeat_delay"..id)
			local tg = time_global()
			if not headshot_start_time[id] then
				headshot_start_time[id] = tg
				time_at_end_table[id] = (headshot_start_time[id]/1000) + fast_repeat_duration
				headshot_counter[id] = 1
			else
				headshot_counter[id] = headshot_counter[id] + 1
				local time_since_headshot = tg - headshot_start_time[id]
				time_at_end_table[id] = (tg/1000) + (fast_repeat_duration*headshot_counter[id]) - (time_since_headshot/1000)
				printf("%s,%s,%s,%s", tg, headshot_start_time[id], time_since_headshot, fast_repeat_duration)
				-- 4956060,4951118,4942,5
			end
			fast_repeat_duration_table[id] = (time_at_end_table[id] - (tg/1000)) > 0 and (time_at_end_table[id] - (tg/1000)) or fast_repeat_duration
	
			printf("changing repeat delay to %s", fast_repeat_duration_table[id])
			-- reset the timing back to normal after a 'fast_repeat_duration' amount of time
			CreateTimeEvent("arksek_funny_gun", "reset_to_lower_repeat_delay" .. id, fast_repeat_duration_table[id], function(id)
				repeat_delays_table["repeat_delay"..id] = normal_repeat_timing
				fast_repeat_duration_table[id] = nil
				headshot_start_time[id] = nil
				time_at_end_table[id] = nil
				headshot_counter[id] = nil
				return true
			end,id)
		end
	end
elseif cxv_artigrok_bo then
	artigrok_bo_npc = cxv_artigrok_bo.npc_on_before_hit
	
	cxv_artigrok_bo.npc_on_before_hit = function(npc, shit, bone_id)
		local hit_data = artigrok_bo_npc(npc, shit, bone_id)
		-- if the shot is not by actor...
		
		if hit_data then
		
			if shit.draftsman:id() ~= AC_ID then
				return hit_data
			end
			-- if the shot is not a headshot...
			if not (tonumber(bone_id) >= 14 and tonumber(bone_id) <= 19) then
				return hit_data
			end
			-- if the shot isnt from the energy gun
			-- if the npc is dead...
			if ((npc.health - hit_data.shit.power) <= 0) or (hit_data.surrender_bonus == 1 and (hit_data.shit.power < npc.health)) then
				local wpn = db.actor:active_item()
				if not wpn then return end
				local parent_section = ini_sys:r_string_ex(wpn:section(), "parent_section") or wpn:section()
				if parent_section ~= weapon_section then return end
				local id = wpn:id()
				repeat_delays_table["repeat_delay"..id] = fast_repeat_timing
				--repeat_delay = fast_repeat_timing
				ResetTimeEvent("arksek_funny_gun", "repeat_loop_for_"..id, repeat_delays_table["repeat_delay"..id])
				RemoveTimeEvent("arksek_funny_gun", "reset_to_lower_repeat_delay"..id)
				local tg = time_global()
				if not headshot_start_time[id] then
					headshot_start_time[id] = tg
					time_at_end_table[id] = (headshot_start_time[id]/1000) + fast_repeat_duration
					headshot_counter[id] = 1
				else
					headshot_counter[id] = headshot_counter[id] + 1
					local time_since_headshot = tg - headshot_start_time[id]
					time_at_end_table[id] = (tg/1000) + (fast_repeat_duration*headshot_counter[id]) - (time_since_headshot/1000)
					printf("%s,%s,%s,%s", tg, headshot_start_time[id], time_since_headshot, fast_repeat_duration)
					-- 4956060,4951118,4942,5
				end
				fast_repeat_duration_table[id] = (time_at_end_table[id] - (tg/1000)) > 0 and (time_at_end_table[id] - (tg/1000)) or fast_repeat_duration
		
				printf("changing repeat delay to %s", fast_repeat_duration_table[id])
				-- reset the timing back to normal after a 'fast_repeat_duration' amount of time
				CreateTimeEvent("arksek_funny_gun", "reset_to_lower_repeat_delay" .. id, fast_repeat_duration_table[id], function(id)
					repeat_delays_table["repeat_delay"..id] = normal_repeat_timing
					fast_repeat_duration_table[id] = nil
					headshot_start_time[id] = nil
					time_at_end_table[id] = nil
					headshot_counter[id] = nil
					return true
				end,id)
			end
			
		end
	end
end