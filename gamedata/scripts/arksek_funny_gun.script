-- verdatim.
-- only works for gamma
-- ilrathCXV (10/17/26): Edited to allow compat. and functionality for ArtiGrok for "The Seven Thunders of Retribution" weapon mod
						-- This script should not crash if you do not use the weapon mod

-- change with the gun's parent section
weapon_section = "wpn_setsuna"

-- all time units are seconds unless stated otherwise
-- how fast the gun recharges one bullet. also how fast it recharges upon a lethal headshot
normal_repeat_timing = 2
fast_repeat_timing = 0.5

-- how long the lethal headshot boost lasts
fast_repeat_duration = 5

-- update timer, basically defines how long it takes for the script to update and notice the gun is the weapon_section, probably shouldnt play around with this too much
update_time = 1

local repeat_delay = normal_repeat_timing

function on_game_start()
	RegisterScriptCallback("actor_on_first_update", actor_on_first_update)
end

function actor_on_first_update()
	CreateTimeEvent("arksek_funny_gun", "repeating_loop", 0, check_for_new_guns)
end

--[[
CWeapon methods
GetAmmoElapsed
GetAmmoMagSize
SetAmmoElapsed
]]

headshot_start_time = {}

repeat_delays_table = {}

fast_repeat_duration_table = {}

time_at_end_table = {}

headshot_counter = {}

function check_for_new_guns()
	local function iterator(_, itm)
		if not itm then return end
		if not itm:is_weapon() then return end
		local parent_section = ini_sys:r_string_ex(itm:section(), "parent_section") or itm:section()
		if parent_section ~= weapon_section then return end
		local id = itm:id()
		if repeat_delays_table["repeat_delay"..id] then
			return
		end
		repeat_delays_table["repeat_delay"..id] = repeat_delay
		CreateTimeEvent("arksek_funny_gun", "repeat_loop_for_" .. id, repeat_delays_table["repeat_delay"..id], replenish_ammo_loop, id)
	end
	db.actor:iterate_inventory(iterator, db.actor)
	ResetTimeEvent("arksek_funny_gun", "repeating_loop", update_time)
end


function replenish_ammo_loop(id)
	--printf("id is %s", id)
	if not id then return true end
	local delay = repeat_delays_table["repeat_delay"..id]
	local wpn = get_object_by_id(id)
	local in_inventory = false
	db.actor:iterate_inventory(function(_,itm)
		if not itm then return end
		if itm:id() == id then
			in_inventory = true
			return true
		end
	end
	, db.actor)
	if not in_inventory then
		repeat_delays_table["repeat_delay"..id] = nil
		printf("item id %s not in invetory, unregistering", id)
		return true
	end
	if not wpn then 
		ResetTimeEvent("arksek_funny_gun", "repeat_loop_for_"..id, update_time)
		--printf("not wpn")
		return 
	end
	local parent_section = ini_sys:r_string_ex(wpn:section(), "parent_section") or wpn:section()
	if parent_section ~= weapon_section then 
		ResetTimeEvent("arksek_funny_gun", "repeat_loop_for_"..id, update_time)
		--printf("not the right section")
		return 
	end
	local wpn_cast = wpn:cast_Weapon()
	local ammo_count = wpn_cast:GetAmmoElapsed()
	-- if ammo_count is max...
	if ammo_count == wpn_cast:GetAmmoMagSize() then 
		ResetTimeEvent("arksek_funny_gun", "repeat_loop_for_"..id, update_time)
		--printf("full ammo for id %s", id)
		return 
	end
	if wpn:get_state() == 5 then
		ResetTimeEvent("arksek_funny_gun", "repeat_loop_for_"..id, update_time)
		local tg = time_global()
		local time_until_end = (time_at_end_table[id] or 0) - tg/1000
		if time_until_end and time_until_end > 0 then
			-- add extra time since this cycle is skipped
			time_until_end = time_until_end + update_time
			time_at_end_table[id] = time_at_end_table[id] + update_time
			printf("time until headshot boost ends is %s", time_until_end)
			ResetTimeEvent("arksek_funny_gun", "reset_to_lower_repeat_delay"..id, time_until_end)
		end
		--printf("gun id %s is shooting", id)
		return 
	end
	ammo_count = ammo_count + 1
	wpn_cast:SetAmmoElapsed(ammo_count)
	--printf("increasing ammo for id %s", id)
	-- reset the funny loop with the delay as set
	ResetTimeEvent("arksek_funny_gun", "repeat_loop_for_"..id, delay)
end
	
	
